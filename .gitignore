.env
node_modules/
webui/node_modules/
webui/.vite/
npm-debug.log*
yarn-error.log*

# --- Boiling-Snow-TTS 核心隔离资产 ---
# 导出成品
out/
# 生成历史日志
assets/production/
# 原始素材 (新)
assets/reference/
# 原始素材 (旧)
assets/reference_audio/
# 黄金样音核心库 (资产保值)
assets/temp/
# 模型权重文件 (禁止上传)
models/

# --- 敏感配置隔离 ---
# 个人角色映射配置 (禁止上传)
configs/personas.json
# 实验配置（默认不上传）
configs/scratch/
# 音色设计配方 (本地缓存)
voice_designs/
# (废弃) 旧版种子路径
assets/designed_seeds/
# (废弃) 旧版导出路径
assets/output_audio/
# (废弃) 旧版日志路径
assets/metadata/

# --- 运行时生成的临时配置 ---
configs/generated/
configs/scripts.json

# --- 全局音频资产防上传 ---
# 任何包含 audio 命名的目录
**/*audio*/
# 常见音频目录命名
**/reference/
**/reference_audio/
**/output_audio/
**/temp_audio/
**/recordings/
**/voices/
# 常见音频文件后缀
*.wav
*.mp3
*.m4a
*.flac
*.ogg
*.opus
*.aac
*.wma
*.aiff
*.alac

# --- Web UI 构建产物 ---
web/static/assets/
web/static/index.html


# ── 目录重排后的新布局（2026-08-30）──
# library/ 是长期资产：音色参考音、预设配方。
#   参考音（*.wav）已被上面的规则忽略 —— 它是二进制资产，属于本机而非仓库，
#   要备份该走备份，不该塞进 git 让每次 clone 都拖几百 MB。
#   但**预设配方的 json 要入库** —— 那是可读的配置，值得版本化。
library/voices/*/reference.wav
library/voices/*/sample.wav

# publish/ 是发行物料，按平台要求的结构组织（Audio/歌词/Cover）。
# 整个目录都是产出，重新 pack 一次就有。
publish/

# 发布物料：音频和封面体积大，且都能从台账 + Suno 重新生成
publish/2*/
publish/covers/
# 但模板要进 git —— 它是项目资产不是产物，丢了打包会在最后一步失败
!publish/templates/

# 艺人档案含真实姓名，属于个人信息，不进仓库
configs/artist.json

# 作品台账含歌词与发布配置，属于个人数据
configs/pipeline.json

# 数据已经搬到 ~/.voxflow —— 这些目录不该再出现在项目里。
# 留着规则是防止将来手滑又在项目里生成数据。
/out/
/assets/temp/
/assets/reference_audio/
/models/
/voice_designs/
/configs/personas.json
/configs/artist.json
/configs/scripts.json
/configs/publish_accounts.json
/configs/generated/

# SQLite 台账（数据，不是代码）
/configs/voxflow.db

# --- 运行时遥测日志（agent-eyes 每次运行都写，不该进 git）---
web/ui/log/**/*.log
web/ui/log/**/snapshots/
web/ui/log/instances.json
